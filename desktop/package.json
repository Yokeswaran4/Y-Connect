{
  "name": "y-connect",
  "version": "2.0.0",
  "description": "Y Connect - notification, clipboard and file sync between your devices over WLAN",
  "main": "main.js",
  "author": "Yokeswaran N",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "start": "electron .",
    "test": "node test/paircrypto.test.js && node test/storage.test.js && node test/terminal.test.js && node test/transfer.test.js && node test/screen.test.js && node test/updates.test.js && node test/inputctl.test.js && node test/adbctl.test.js",
    "dist:linux": "npx --yes electron-builder@^26.15.0 --linux AppImage",
    "dist:win": "npx --yes electron-builder@^26.15.0 --win nsis portable"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^45.2.1"
  },
  "build": {
    "appId": "com.yokeswaran.yconnect",
    "productName": "Y Connect",
    "files": [
      "main.js",
      "preload.js",
      "transfer.js",
      "screen.js",
      "capture-preload.js",
      "viewer-preload.js",
      "remote.js",
      "storage.js",
      "battery.js",
      "autostart.js",
      "deviceinfo.js",
      "latency.js",
      "legacy.js",
      "paircrypto.js",
      "updates.js",
      "notifwatch.js",
      "renderer/**",
      "build/icon.png",
      "licenses/**",
      "adbctl.js",
      "inputctl.js",
      "vendor/**"
    ],
    "directories": {
      "buildResources": "build"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "icon": "build/icon.png",
      "artifactName": "Y-Connect-v2.0.${ext}",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "Y-Connect-Setup-v2.0.${ext}"
    },
    "portable": {
      "artifactName": "Y-Connect-Portable-v2.0.${ext}"
    },
    "asarUnpack": [
      "vendor/**"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "electron": true
  },
  "desktopName": "y-connect.desktop"
}
